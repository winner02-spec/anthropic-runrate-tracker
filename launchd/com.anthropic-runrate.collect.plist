<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  수집 스케줄(3시간 간격). ※ 생성·검증만. 사용자 승인 전 launchctl load 하지 말 것.
  등록(승인 후):
    cp launchd/com.anthropic-runrate.collect.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.anthropic-runrate.collect.plist
  전제: .venv (python3.11 -m venv .venv && pip install -r requirements.txt) 생성돼 있어야 함.
-->
<plist version="1.0"><dict>
  <key>Label</key><string>com.anthropic-runrate.collect</string>
  <key>ProgramArguments</key><array>
    <string>/bin/zsh</string>
    <string>/Users/baeeunbin/market-bots/anthropic-runrate-tracker/scripts/run_collect.sh</string>
  </array>
  <key>StartInterval</key><integer>10800</integer>
  <key>StandardOutPath</key><string>/Users/baeeunbin/market-bots/anthropic-runrate-tracker/logs/launchd.collect.log</string>
  <key>StandardErrorPath</key><string>/Users/baeeunbin/market-bots/anthropic-runrate-tracker/logs/launchd.collect.log</string>
</dict></plist>
