<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 매일 08:30 KST: daily discovery(최근7일 수집+새 출처 탐색). 3시간 수집은 폐지.
     ※ 생성·plutil 검증까지만. 사용자 승인 전 launchctl load 금지. 전제: .venv 생성. -->
<plist version="1.0"><dict>
  <key>Label</key><string>com.anthropic-runrate.daily</string>
  <key>ProgramArguments</key><array>
    <string>/bin/zsh</string>
    <string>/Users/baeeunbin/market-bots/anthropic-runrate-tracker/scripts/run_daily.sh</string>
  </array>
  <key>StartCalendarInterval</key><array>
    <dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>30</integer></dict>
  </array>
  <key>StandardOutPath</key><string>/Users/baeeunbin/market-bots/anthropic-runrate-tracker/logs/launchd.daily.log</string>
  <key>StandardErrorPath</key><string>/Users/baeeunbin/market-bots/anthropic-runrate-tracker/logs/launchd.daily.log</string>
</dict></plist>
