# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 절대 커밋되지 않습니다)
#   cp .env.example .env
#
# Anthropic Revenue Run-rate Tracker — 환경변수
# 모든 비밀값은 .env 에만. 배포물(정적 JSON)에는 포함되지 않습니다.

# ── Telegram 알림 (선택) ──
# 키가 없어도 수집·검토·대시보드는 정상 동작합니다(알림만 비활성).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Anthropic API (선택 기능) ──
# 없어도 기본 수집·검토·대시보드 동작. LLM 보조 추출을 켤 때만 사용.
ANTHROPIC_API_KEY=

# ── 실행 옵션 ──
TZ=Asia/Seoul
# 대시보드 공개 URL(README/문서 표기용; 배포 후 채움)
DASHBOARD_URL=
# Telegram 실제 발송 여부. false 면 dry-run(콘솔 출력)만.
TELEGRAM_ENABLED=false
